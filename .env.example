# ==============================================================================
# FoodBridge AI Environment Configuration Template
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI features (AI matching, description generator, impact insights)
# In Google AI Studio, this is injected automatically from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where the FoodBridge AI applet is hosted
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing and validating JWT authentication tokens
JWT_SECRET="foodbridge_secure_jwt_secret_key_2026"

# PORT: Server listener port (defaults to 3000)
PORT=3000

# NODE_ENV: Runtime mode ('development' or 'production')
NODE_ENV="development"

# ==============================================================================
# Supabase PostgreSQL Configuration (Production Database)
# To use Supabase:
# 1. Create a Supabase project at https://supabase.com
# 2. Run the DDL script in /database/supabase_schema.sql via Supabase SQL Editor
# 3. Supply SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY below
# Note:
# - SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the Express backend (server/db/supabase.ts)
#   and is NEVER exposed or bundled into Vite frontend code (no VITE_ prefix).
# - The frontend communicates solely with /api/* routes authenticated with custom Express JWTs.
# - If unset, the app runs using local resilient JSON storage with atomic Mutex locking.
# ==============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

